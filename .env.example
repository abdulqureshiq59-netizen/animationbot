# ----------------------------------------------------------------------------
# AISA — AI Cartoon Demo Pipeline — environment variables
# Copy this file to .env and fill in only the keys you actually have.
# Every provider below has a FREE fallback that works with NO key at all,
# so the pipeline will still run end-to-end with this file left empty.
# ----------------------------------------------------------------------------

# --- Script / story generation (LLM) ---------------------------------------
# Free options with a generous no-cost tier (pick ONE, or leave both blank
# to use the built-in offline template writer):
#   Google Gemini  -> https://aistudio.google.com/apikey   (free tier)
#   Groq           -> https://console.groq.com/keys        (free tier, fast)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Character reference sheet (image generation) ---------------------------
# Default provider is Pollinations.ai — fully free, no key needed.
# Leave blank unless you upgrade to a paid image model later.
STABILITY_API_KEY=

# --- Shot / image-to-video generation ---------------------------------------
# Default fallback (no key needed) animates each character image with a
# "Ken Burns" pan/zoom effect — not true AI video, but works for a first demo.
# Add a real key below once you want actual AI-generated motion:
KLING_API_KEY=
RUNWAY_API_KEY=

# --- Voice (text-to-speech) --------------------------------------------------
# Default provider is edge-tts — fully free, no key needed, many languages.
# Add this only if you want higher-quality cloned/locked voices later:
ELEVENLABS_API_KEY=

# --- Music / SFX --------------------------------------------------------------
# Default: a bundled royalty-free ambient bed + simple SFX (no key needed).
# Add this only if you want AI-generated original music later:
SUNO_API_KEY=
